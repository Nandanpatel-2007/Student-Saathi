# Copy to .env and adjust.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite for dev; Postgres example: postgres://user:password@localhost:5432/student_saathi
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TIME_ZONE=Asia/Kolkata
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Analytics (all optional; defaults shown)
ATTENDANCE_THRESHOLD_PERCENT=75
ATTENDANCE_WARNING_UPPER_PERCENT=80
ATTENDANCE_LATE_COUNTS_AS_PRESENT=True
# EXCLUDE | PRESENT | ABSENT
ATTENDANCE_EXCUSED_POLICY=EXCLUDE
PASS_MARK_PERCENT=40
SHARP_DROP_POINTS=15
